# Environment is supplied by build-gui.sh from the air/OS SDK's env.sh.
set(CMAKE_SYSTEM_NAME Haiku)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER "$ENV{CROSS}gcc")
set(CMAKE_CXX_COMPILER "$ENV{CROSS}g++")
set(CMAKE_SYSROOT "$ENV{SYSROOT}")
set(_deps "$ENV{HAIKU_GUI_DEPS}")
set(CMAKE_C_FLAGS_INIT "-specs=$ENV{UNWIND_SPECS}")
set(CMAKE_CXX_FLAGS_INIT "-specs=$ENV{UNWIND_SPECS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${_deps}/develop/lib -L${_deps}/lib -Wl,-rpath-link,${_deps}/lib")
set(CMAKE_FIND_ROOT_PATH "${_deps}" "${CMAKE_SYSROOT}")
set(CMAKE_PREFIX_PATH "${_deps}" "${_deps}/develop")
set(CMAKE_INCLUDE_PATH "${_deps}/develop/headers")
set(CMAKE_LIBRARY_PATH "${_deps}/develop/lib" "${_deps}/lib")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
