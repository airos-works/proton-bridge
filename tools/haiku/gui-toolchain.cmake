# Environment is supplied by build-gui.sh from the air/OS SDK's env.sh.
set(CMAKE_SYSTEM_NAME Haiku)
if(DEFINED ENV{HAIKU_PROCESSOR})
    set(CMAKE_SYSTEM_PROCESSOR "$ENV{HAIKU_PROCESSOR}")
else()
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
endif()
set(CMAKE_C_COMPILER "$ENV{CROSS}gcc")
set(CMAKE_CXX_COMPILER "$ENV{CROSS}g++")
set(CMAKE_SYSROOT "$ENV{SYSROOT}")
set(_deps "$ENV{HAIKU_GUI_DEPS}")
set(CMAKE_C_FLAGS_INIT "-specs=$ENV{UNWIND_SPECS}")
set(CMAKE_CXX_FLAGS_INIT "-specs=$ENV{UNWIND_SPECS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${_deps}/develop/lib -L${_deps}/lib -Wl,-rpath-link,${_deps}/lib")
set(CMAKE_FIND_ROOT_PATH "${_deps}" "${CMAKE_SYSROOT}")
# arm64: the libraries the images have (FreeType, GL) that Qt's packages
# depend on, as a boot/system tree
if(DEFINED ENV{HAIKU_GUI_EXTRA})
    set(_extra "$ENV{HAIKU_GUI_EXTRA}")
    string(REGEX REPLACE "/boot/system$" "" _extra_root "${_extra}")
    string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -L${_extra}/develop/lib -Wl,-rpath-link,${_extra}/lib")
    list(INSERT CMAKE_FIND_ROOT_PATH 1 "${_extra_root}")
    # Qt's Gui needs OpenGL: libglvnd's, which FindOpenGL does not look for
    set(OpenGL_GL_PREFERENCE LEGACY)
    set(OPENGL_INCLUDE_DIR "${_extra}/develop/headers/os/opengl" CACHE PATH "")
    set(OPENGL_gl_LIBRARY "${_extra}/lib/libGL.so" CACHE FILEPATH "")
endif()
set(CMAKE_PREFIX_PATH "${_deps}" "${_deps}/develop")
set(CMAKE_INCLUDE_PATH "${_deps}/develop/headers")
set(CMAKE_LIBRARY_PATH "${_deps}/develop/lib" "${_deps}/lib")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
